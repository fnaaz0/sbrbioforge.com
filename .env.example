# ============================================================================
# SBRBIOFORGE ENVIRONMENT CONFIGURATION
# Production API Keys & Secrets Registry
# 300-Year Civilization Engine - Phase 1 Deployment
# ============================================================================
# 
# SECURITY WARNING: 
# - NEVER commit actual API keys to version control
# - Use this file as a reference template only
# - Copy to .env and fill with real values locally
# - Always use os.environ.get() to load these values
# - Implement environment-based secret management for production
#
# ============================================================================

# ============================================================================
# CLIMATE & ENVIRONMENTAL DATA APIs
# ============================================================================

# OpenWeather API - Real-time weather, air quality, and AQI data
# Supports: Temperature, Humidity, Air Quality Index, Pollution metrics
# Free/Paid tier available at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA API - Earth observation, water level, climate data
# Supports: MODIS imagery, SEDAC data, power data, planetary imagery
# Free access at https://api.nasa.gov
NASA_API_KEY=your_nasa_api_key_here

# AirNow EPA API - US Air Quality Index data
# Supports: Real-time AQI, pollution levels, health recommendations
# Free access at https://docs.airnowapi.com/
AIRNOW_API_KEY=your_airnow_api_key_here

# ============================================================================
# AI & LANGUAGE MODELS - COGNITIVE ENGINES
# ============================================================================

# Groq API - Ultra-fast LLM inference for real-time translations
# Supports: Omni-language processing, rapid response times
# Sign up at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude API - Advanced reasoning & language understanding
# Supports: Complex analysis, health guidelines, survival protocols
# Access at https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI GPT API - State-of-the-art language model
# Supports: GPT-4, GPT-3.5-turbo, content analysis
# Access at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# xAI Grok API - Real-time reasoning for climate intelligence
# Supports: Current events, live data analysis, reasoning
# Access at https://console.x.ai/ (if available)
GROK_API_KEY=your_grok_api_key_here

# Google Gemini API - Multi-modal language understanding
# Supports: Vision, text analysis, environmental data processing
# Access at https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# AUDIO & VOICE SYNTHESIS - OMNI-LANGUAGE VOICE ENGINE
# ============================================================================

# ElevenLabs API - Real-time voice synthesis for 29+ languages
# Supports: Multilingual TTS, natural speech, voice cloning
# Premium latency <500ms for real-time alert playback
# Access at https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=default_voice_id

# ============================================================================
# VIDEO & VISUAL PROCESSING
# ============================================================================

# Luma AI - Video generation from text/images for survival tutorials
# Supports: Real-time video synthesis, visual demonstrations
# Access at https://lumalabs.ai/
LUMA_API_KEY=your_luma_api_key_here

# NVIDIA API (NVIDIA Cloud/AI API) - GPU-accelerated processing
# Supports: Fast inference, climate model computation
# Access at https://developer.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================================================
# MAPPING & GEOSPATIAL SERVICES
# ============================================================================

# Google Maps API - Location services, geocoding, maps visualization
# Supports: Reverse geocoding, Maps display, route optimization
# Enable in Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================================================
# FIREBASE & CLOUD INFRASTRUCTURE
# ============================================================================

# Firebase Project ID - Cloud backend for sync & notifications
# Configure in Firebase Console: https://console.firebase.google.com/
FIREBASE_PROJECT_ID=your_firebase_project_id

# Firebase API Key - Client-side Firebase authentication
FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Database URL - Real-time data sync
FIREBASE_DATABASE_URL=your_firebase_database_url

# Firebase Storage Bucket - Media & file storage
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket

# ============================================================================
# DATABASE & LOCAL STORAGE CONFIGURATION
# ============================================================================

# SQLite Offline Vault - Local database for 30-day cache
# Stores: Environmental metrics, user data, offline guides
# Auto-managed by database.py - no API key required
OFFLINE_DATABASE_PATH=sbr_offline_vault.db
OFFLINE_CACHE_DAYS=30

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment Mode - development, staging, or production
ENV_MODE=development

# App Language - default language for multilingual interface
DEFAULT_LANGUAGE=en

# Logging Level - debug, info, warning, error
LOG_LEVEL=debug

# API Timeout - seconds before request timeout
API_TIMEOUT_SECONDS=15

# GPS Accuracy - high, medium, low (balances battery vs precision)
GPS_ACCURACY=high

# Environment Update Interval - minutes between metric refreshes
ENV_UPDATE_INTERVAL_MINUTES=5

# ============================================================================
# BACKEND SERVER CONFIGURATION (Python app.py v7.0)
# ============================================================================

# Backend Server URL - Flask/FastAPI server endpoint
BACKEND_SERVER_URL=http://localhost:5000

# Backend API Version
BACKEND_API_VERSION=v7.0

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# JWT Secret Key - For secure token generation
JWT_SECRET_KEY=your_jwt_secret_key_here

# Encryption Salt - For secure local storage
ENCRYPTION_SALT=your_encryption_salt_here

# ============================================================================
# SENTRY ERROR MONITORING (Optional)
# ============================================================================

# Sentry DSN - For crash reporting and error tracking
SENTRY_DSN=your_sentry_dsn_here

# ============================================================================
# INSTRUCTIONS FOR USE
# ============================================================================
#
# 1. Copy this file to .env in the project root
#    $ cp .env.example .env
#
# 2. Fill in all API keys with real values
#    - Obtain keys from respective service providers
#    - Never share .env file or commit to version control
#
# 3. In Flutter, load via flutter_dotenv:
#    ```dart
#    await dotenv.load(fileName: '.env');
#    String openWeatherKey = dotenv.env['OPENWEATHER_API_KEY'] ?? '';
#    ```
#
# 4. In Python (app.py v7.0), load via os.environ:
#    ```python
#    import os
#    from dotenv import load_dotenv
#    load_dotenv()
#    groq_key = os.environ.get('GROQ_API_KEY')
#    ```
#
# 5. For production deployment:
#    - Use GitHub Secrets for CI/CD
#    - Use cloud provider secret management (AWS Secrets Manager, Google Secret Manager)
#    - Never store keys in code or version control
#    - Rotate keys regularly
#    - Monitor API usage for suspicious activity
#
# ============================================================================
# TESTING & DEVELOPMENT NOTES
# ============================================================================
#
# For local development without paid APIs:
# - Use free tiers with limited requests
# - Mock API responses for testing
# - Use offline fallback data by default
# - Test GPS with emulator location spoofing
#
# For CI/CD pipeline:
# - Set secrets in GitHub Actions environment
# - Use separate keys for dev/staging/production
# - Implement rate limiting to avoid quota issues
#
# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
#
# Before deploying to production:
# ☐ All API keys configured and tested
# ☐ .env file is NOT in git repository (.gitignore)
# ☐ Secrets stored in cloud provider
# ☐ API rate limits verified for peak usage
# ☐ Error handling for API failures tested
# ☐ Offline fallback mechanisms verified
# ☐ HTTPS/TLS enabled for all API calls
# ☐ CORS headers properly configured
# ☐ Input validation on all user data
# ☐ Security audit completed
#
# ============================================================================
